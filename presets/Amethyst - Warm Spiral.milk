MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fRating=3.000000
fGammaAdj=1.980000
fDecay=0.950000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=6
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bMaximizeWaveColor=0
bTexWrap=1
fWaveAlpha=0.8
fWaveScale=1.2
fZoom=1.01
fRot=0.0
wave_r=1.0
wave_g=0.5
wave_b=0.2
zoom=1.02
rot=0.01
per_frame_1=wave_r = 0.5+0.5*sin(time*1.1);
per_frame_2=wave_g = 0.5+0.5*sin(time*1.7);
per_frame_3=rot = 0.02*sin(time) + bass*0.01;
per_pixel_1=zoom = zoom + 0.03*rad*bass_att;
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz;
warp_4=`    ret += 0.02*sin(time + uv.x*10);
warp_5=`    ret *= 0.98;
warp_6=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_main, uv).xyz;
comp_4=`    ret = pow(ret, 0.8) * 1.4;
comp_5=`}
