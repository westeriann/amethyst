MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fRating=5.000000
fGammaAdj=1.000000
fDecay=0.980000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=7
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=1.000000
fWaveScale=0.700000
fWaveSmoothing=0.600000
zoom=0.960000
rot=0.000000
cx=0.500000
cy=0.500000
warp=0.200000
sx=1.000000
sy=1.000000
wave_r=0.300000
wave_g=0.900000
wave_b=1.000000
ob_size=0.005000
ob_a=0.000000
ib_a=0.000000
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_bSpectrum=1
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.500000
wavecode_0_r=1.000000
wavecode_0_g=0.200000
wavecode_0_b=0.800000
wavecode_0_a=1.000000
wave_0_per_point1=ang = sample*6.2832 + time*0.3;
wave_0_per_point2=r = 0.25 + value1*0.2;
wave_0_per_point3=x = 0.5 + r*cos(ang)*0.75;
wave_0_per_point4=y = 0.5 + r*sin(ang);
shapecode_0_enabled=1
shapecode_0_sides=6
shapecode_0_additive=1
shapecode_0_thickOutline=1
shapecode_0_textured=0
shapecode_0_num_inst=3
shapecode_0_x=0.500000
shapecode_0_y=0.500000
shapecode_0_rad=0.100000
shapecode_0_ang=0.000000
shapecode_0_r=0.0
shapecode_0_g=1.0
shapecode_0_b=0.8
shapecode_0_a=0.4
shapecode_0_r2=0.5
shapecode_0_g2=0.0
shapecode_0_b2=1.0
shapecode_0_a2=0.0
shapecode_0_border_a=0.8
shape_0_per_frame1=ang = time*0.5 + instance*2.094;
shape_0_per_frame2=rad = 0.08 + bass_att*0.05;
shape_0_per_frame3=x = 0.5 + 0.25*cos(time*0.7 + instance*2.094);
shape_0_per_frame4=y = 0.5 + 0.25*sin(time*0.7 + instance*2.094);
per_frame_init_1=q1 = 0;
per_frame_1=q1 = q1 + 0.01*bass;
per_frame_2=wave_r = 0.5 + 0.5*sin(time);
per_frame_3=monitor = q1;
per_pixel_1=rot = 0.03*sin(rad*8 - time) * (1+treb_att);
per_pixel_2=zoom = 0.96 + 0.04*rad;
warp_1=`shader_body
warp_2=`{
warp_3=`    float2 d = uv - 0.5;
warp_4=`    float2 uv2 = uv + d*0.01*sin(time + length(d)*20);
warp_5=`    ret = tex2D(sampler_main, uv2).xyz;
warp_6=`    ret += (tex2D(sampler_noise_lq, uv*0.5 + time*0.01).xyz - 0.5)*0.03;
warp_7=`    ret *= 0.97;
warp_8=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float3 blur = GetBlur1(uv);
comp_4=`    ret = tex2D(sampler_main, uv).xyz + blur*0.6;
comp_5=`    ret *= float3(0.9, 1.0, 1.2) * (1.0 + q1*0.0);
comp_6=`    ret = lerp(ret, 1 - ret, saturate(bass_att - 1.5));
comp_7=`}
